// Сохранение в файл (один МН и один НПС)
void Menu_6(const MN& pipe, const NPS& nps) {
    ofstream f_out("pipes.txt");
    if (!f_out) {
        cout << "Не удалось открыть файл для записи.\n";
        return;
    }

    f_out << pipe.get_name() << '\n'
        << pipe.get_d() << '\n'
        << pipe.get_l() << '\n'
        << pipe.get_rejim() << '\n';

    f_out << nps.get_name_nps() << '\n'
        << nps.get_n_mna() << '\n'
        << nps.get_on_mna() << '\n'
        << nps.get_vid_nps() << '\n';

    cout << "Данные сохранены в файл pipes.txt\n";
}


