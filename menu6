#include <iostream>
#include <string>
#include <windows.h>
#include <fstream>
using namespace std;

class MN {
private:
    string name_mn;
    int d_mn;
    float l_mn;
    bool rejim_mn;

public:
    MN(const string& n = "", int d = 0, float l = 0.0f, bool r = false)
        : name_mn(n), d_mn(d), l_mn(l), rejim_mn(r) {
    }

    void set_name(const string& n) { name_mn = n; }
    void set_d(int d) { d_mn = d; }
    void set_l(float l) { l_mn = l; }
    void set_rejim(bool r) { rejim_mn = r; }

    string get_name()  const { return name_mn; }
    int    get_d()     const { return d_mn; }
    float  get_l()     const { return l_mn; }
    bool   get_rejim() const { return rejim_mn; }
};

class NPS {
private:
    string name_nps;
    int n_mna;
    int on_mna;
    bool vid_nps;

public:
    NPS(const string& nnps = "", int k = 0, int on = 0, bool v = false)
        : name_nps(nnps), n_mna(k), on_mna(on), vid_nps(v) {
    }

    void set_name_nps(const string& nnps) { name_nps = nnps; }
    void set_n_mna(int k) { n_mna = k; }
    void set_on_mna(int on) { on_mna = on; }
    void set_vid_nps(bool v) { vid_nps = v; }

    string get_name_nps()  const { return name_nps; }
    int    get_n_mna()     const { return n_mna; }
    int    get_on_mna()    const { return on_mna; }
    bool   get_vid_nps()   const { return vid_nps; }
};

void Menu_0() { cout << "Выход\n"; }

// Ввод / изменение МН
void Menu_1(MN& pipe) {
    string tmp;
    int d, r;
    float l;

    cout << "Введите наименование МН\n";
    getline(cin >> ws, tmp);
    cout << "Введите диаметр МН (мм): ";  cin >> d;
    cout << "Введите длину МН (км): ";    cin >> l;
    cout << "Введите режим МН (0/1): ";   cin >> r;
    cin.ignore(10000, '\n');

    pipe.set_name(tmp);
    pipe.set_d(d);
    pipe.set_l(l);
    pipe.set_rejim(r != 0);

    cout << "\nДобавление МН:\n"
        << "  Наименование: " << pipe.get_name() << '\n'
        << "  Диаметр:      " << pipe.get_d() << " мм\n"
        << "  Длина:        " << pipe.get_l() << " км\n"
        << "  Режим:        " << (pipe.get_rejim() ? "в работе" : "остановлен") << '\n';
}

// Ввод / изменение НПС
void Menu_2(NPS& nps) {
    string tmp1;
    int k, on, v;

    cout << "Введите наименование НПС \n";
    getline(cin >> ws, tmp1);
    cout << "Введите количество МНА(шт): ";  cin >> k;
    cout << "Введите количество работающих МНА(шт): ";    cin >> on;
    cout << "Введите вид НПС (0- промежуточная/1- головная): ";   cin >> v;
    cin.ignore(10000, '\n');

    nps.set_name_nps(tmp1);
    nps.set_n_mna(k);
    nps.set_on_mna(on);
    nps.set_vid_nps(v != 0);

    cout << "\nДобавление НПС:\n"
        << "  Наименование: " << nps.get_name_nps() << '\n'
        << "  Количество МНА: " << nps.get_n_mna() << " шт.\n"
        << "  Количество МНА в работе: " << nps.get_on_mna() << " шт.\n"
        << "  Вид: " << (nps.get_vid_nps() ? "головная" : "промежуточная") << '\n';
}

