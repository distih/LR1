// Редактирование МН (без выбора номера)
void Menu_4(MN& pipe) {
    cout << "\n===== Редактирование МН =====\n";
    cout << "(Оставьте поле пустым и нажмите Enter, чтобы сохранить текущее значение)\n\n";

    string tmp_name, d_str, l_str, r_str;

    cout << "Текущее наименование: " << pipe.get_name() << "\n";
    cout << "Введите новое наименование: ";
    getline(cin >> ws, tmp_name);
    if (!tmp_name.empty()) pipe.set_name(tmp_name);

    cout << "Текущий диаметр: " << pipe.get_d() << " мм\n";
    cout << "Введите новый диаметр: ";
    getline(cin, d_str);
    if (!d_str.empty()) {
        try { pipe.set_d(stoi(d_str)); }
        catch (...) { cout << "Ошибка ввода числа. Диаметр не изменен.\n"; }
    }

    cout << "Текущая длина: " << pipe.get_l() << " км\n";
    cout << "Введите новую длину: ";
    getline(cin, l_str);
    if (!l_str.empty()) {
        try { pipe.set_l(stof(l_str)); }
        catch (...) { cout << "Ошибка ввода числа. Длина не изменена.\n"; }
    }

    cout << "Текущий режим: " << (pipe.get_rejim() ? "в работе" : "остановлен") << "\n";
    cout << "Введите новый режим (0 - остановлен, 1 - в работе): ";
    getline(cin, r_str);
    if (!r_str.empty()) {
        try { pipe.set_rejim(stoi(r_str) != 0); }
        catch (...) { cout << "Ошибка ввода числа. Режим не изменен.\n"; }
    }

    cout << "\nМН успешно отредактирован!\n"
        << "  Наименование: " << pipe.get_name() << '\n'
        << "  Диаметр:      " << pipe.get_d() << " мм\n"
        << "  Длина:        " << pipe.get_l() << " км\n"
        << "  Режим:        " << (pipe.get_rejim() ? "в работе" : "остановлен") << '\n';
}



