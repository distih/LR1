#include <iostream>
#include <string>
#include <windows.h>
#include <fstream>
using namespace std;

class MN {
private:
    string name_mn;
    int d_mn;
    float l_mn;
    bool rejim_mn;

public:
    MN(const string& n = "", int d = 0, float l = 0.0f, bool r = false)
        : name_mn(n), d_mn(d), l_mn(l), rejim_mn(r) {
    }

    void set_name(const string& n) { name_mn = n; }
    void set_d(int d) { d_mn = d; }
    void set_l(float l) { l_mn = l; }
    void set_rejim(bool r) { rejim_mn = r; }

    string get_name()  const { return name_mn; }
    int    get_d()     const { return d_mn; }
    float  get_l()     const { return l_mn; }
    bool   get_rejim() const { return rejim_mn; }
};

void Menu_0() { cout << "Выход\n"; }

// Ввод / изменение МН
void Menu_1(MN& pipe) {
    string tmp;
    int d, r;
    float l;

    cout << "Введите наименование МН\n";
    getline(cin >> ws, tmp);
    cout << "Введите диаметр МН (мм): ";  cin >> d;
    cout << "Введите длину МН (км): ";    cin >> l;
    cout << "Введите режим МН (0/1): ";   cin >> r;
    cin.ignore(10000, '\n');

    pipe.set_name(tmp);
    pipe.set_d(d);
    pipe.set_l(l);
    pipe.set_rejim(r != 0);

    cout << "\nДобавление МН:\n"
        << "  Наименование: " << pipe.get_name() << '\n'
        << "  Диаметр:      " << pipe.get_d() << " мм\n"
        << "  Длина:        " << pipe.get_l() << " км\n"
        << "  Режим:        " << (pipe.get_rejim() ? "в работе" : "остановлен") << '\n';
}

