        return;
    }

    cout << "(Оставьте поле пустым и нажмите Enter, чтобы НЕ учитывать критерий)\n\n";

    // сброс '\n', оставшегося после cin >> Num_Menu в main
    cin.ignore(10000, '\n');

    // --- 1. Наименование (подстрока, без учёта регистра) ---
    string name_query;
    cout << "Наименование содержит (Enter - не учитывать): ";
    getline(cin, name_query);

    // --- 2. Количество неработающих МНА ---
    string off_query;
    cout << "Количество неработающих МНА, или пусто: ";
    getline(cin, off_query);
    int off_target = -1;
    if (!off_query.empty()) {
        try {
            size_t pos = 0;
            off_target = stoi(off_query, &pos);
            if (pos != off_query.size()) {
                cout << "Должно быть целым числом — критерий не учитывается.\n";
                off_target = -1;
            }
            else if (off_target < 0) {
                cout << "Количество не может быть отрицательным — критерий не учитывается.\n";
                off_target = -1;
            }
        }
        catch (...) {
            cout << "Ошибка ввода числа — критерий не учитывается.\n";
            off_target = -1;
        }
    }

    // --- 3. Вид НПС ---
    string v_query;
    cout << "Вид НПС (0 - промежуточная, 1 - головная, пусто - не учитывать): ";
    getline(cin, v_query);
    int v_target = -1;
    if (!v_query.empty()) {
        try {
            v_target = stoi(v_query);
            if (v_target != 0 && v_target != 1) {
                cout << "Допустимо только 0 или 1 — критерий не учитывается.\n";
                v_target = -1;
            }
        }
        catch (...) {
            cout << "Ошибка ввода числа — критерий не учитывается.\n";
            v_target = -1;
        }
    }

    // --- Приведение запроса наименования к нижнему регистру ---
    auto to_lower = [](string s) {
        for (char& c : s) c = (char)tolower((unsigned char)c);
        return s;
        };
    string name_lower = to_lower(name_query);

    // --- 4. Фильтрация: объект проходит, если подходит под ВСЕ заданные критерии ---
    int found = 0;
    cout << "\n--- Результаты поиска ---\n";

    for (const NPS& p : nps) {
        // наименование: подстрока, без регистра
        if (!name_query.empty()) {
            string pname = to_lower(p.get_name_nps());
            if (pname.find(name_lower) == string::npos) continue;
        }

        // количество неработающих МНА = всего - в работе
        int off_mna = p.get_n_mna() - (int)p.get_on_mna();
        if (off_target != -1 && off_mna != off_target) continue;

        // вид НПС
        if (v_target != -1 && (int)p.get_vid_nps() != v_target) continue;

        // объект прошёл все заданные фильтры
        ++found;
        cout << "НПС [id=" << p.get_id() << "]\n"
            << "  Наименование:            " << p.get_name_nps() << '\n'
            << "  Количество МНА:          " << p.get_n_mna() << " шт.\n"
            << "  Количество МНА в работе: " << p.get_on_mna() << " шт.\n"
            << "  Неработающих МНА:        " << off_mna << " шт.\n"
            << "  Вид:                     "
            << (p.get_vid_nps() ? "головная" : "промежуточная") << '\n'
            << "----------------------------------\n";
    }

    if (found == 0)
        cout << "Ничего не найдено по заданным критериям.\n";
    else
        cout << "Найдено НПС: " << found << "\n";
}
// Пакетное редактирование МН: найти → выбрать (все / по id) → применить изменение
void Menu_10(vector<MN>& pipes) {
    cout << "\n===== Пакетное редактирование МН =====\n";

    if (pipes.empty()) {
        cout << "Список МН пуст. Сначала добавьте хотя бы один объект (пункт 1).\n";
        return;
    }

    // ---------- Шаг 1. Поиск ----------
    cout << "\n--- Шаг 1. Поиск МН (пустое поле = критерий не учитывать) ---\n";
    cin.ignore(10000, '\n');

    string name_query;
    cout << "Наименование содержит: ";
    getline(cin, name_query);

    string d_query;
    cout << "Диаметр (мм), или пусто: ";
    getline(cin, d_query);
    int d_target = -1;
    if (!d_query.empty()) {
        try {
            size_t pos = 0;
            d_target = stoi(d_query, &pos);
            if (pos != d_query.size() || d_target <= 0) d_target = -1;
        }
        catch (...) { d_target = -1; }
    }

    string r_query;
    cout << "Признак в ремонте (0 - нет, 1 - да, пусто): ";
    getline(cin, r_query);
    int r_target = -1;
    if (!r_query.empty()) {
        try {
            r_target = stoi(r_query);
            if (r_target != 0 && r_target != 1) r_target = -1;
        }
        catch (...) { r_target = -1; }
    }

    vector<size_t> found = find_pipes(pipes, name_query, d_target, r_target);

    if (found.empty()) {
        cout << "Ничего не найдено. Возврат в меню.\n";
        return;
    }

    cout << "\nНайдено МН: " << found.size() << "\n";
    for (size_t i : found) {
        const MN& p = pipes[i];
        cout << "  id=" << p.get_id() << " | " << p.get_name()
            << " (D=" << p.get_d() << ", L=" << p.get_l()
            << ", " << (p.get_rejim() ? "в работе" : "в ремонте") << ")\n";
    }

    // ---------- Шаг 2. Выбор подмножества ----------
    cout << "\n--- Шаг 2. Что редактируем? ---\n"
        << "  1. Все найденные (" << found.size() << " шт.)\n"
        << "  2. Выбрать по id\n"
        << "  0. Отмена\n"
        << "Выбор: ";
    int mode;
    cin >> mode;
    if (cin.fail()) {
        cin.clear(); cin.ignore(10000, '\n');
        cout << "Некорректный ввод. Отмена.\n";
        return;
    }
    cin.ignore(10000, '\n');

    if (mode == 0) { cout << "Отмена.\n"; return; }

    // Индексы в pipes, которые будем менять/удалять
    vector<size_t> targets;

    if (mode == 1) {
        targets = found;   // все найденные
    }
    else if (mode == 2) {
        cout << "Введите id через пробел (Enter — закончить):\n> ";
        string line;
        getline(cin, line);

        // разбираем строку на числа
        vector<int> ids;
        {
            size_t i = 0;
            while (i < line.size()) {
                while (i < line.size() && isspace((unsigned char)line[i])) ++i;
                if (i >= line.size()) break;
                size_t j = i;
                while (j < line.size() && !isspace((unsigned char)line[j])) ++j;
                try { ids.push_back(stoi(line.substr(i, j - i))); }
                catch (...) { cout << "Пропущено: '" << line.substr(i, j - i) << "'\n"; }
                i = j;
            }
        }

        // для каждого введённого id ищем, есть ли он среди найденных
        for (int id : ids) {
            bool in_found = false;
            for (size_t k : found) {
                if (pipes[k].get_id() == id) { in_found = true; targets.push_back(k); break; }
            }
            if (!in_found)
                cout << "  id=" << id << " не входит в найденное множество — пропущен.\n";
        }

        if (targets.empty()) {
            cout << "Ни один id не выбран. Отмена.\n";
            return;
        }
    }
    else {
        cout << "Нет такого режима. Отмена.\n";
        return;
    }

    // ---------- Шаг 3. Что делаем? ----------
    cout << "\n--- Шаг 3. Действие ---\n"
        << "  1. Изменить наименование\n"
        << "  2. Изменить диаметр\n"
        << "  3. Изменить длину\n"
        << "  4. Изменить режим\n"
        << "  5. Удалить выбранные\n"
        << "  0. Отмена\n"
        << "Выбор: ";
    int action;
    cin >> action;
    if (cin.fail()) {
        cin.clear(); cin.ignore(10000, '\n');
        cout << "Некорректный ввод. Отмена.\n";
        return;
    }
    cin.ignore(10000, '\n');

    if (action == 0) { cout << "Отмена.\n"; return; }

    // ---------- Шаг 4. Выполнение ----------
    if (action == 5) {
        // удаление: сначала собираем id, потом стираем по erase-remove,
        // чтобы индексы не «съезжали» в процессе
        vector<int> ids_to_erase;
        for (size_t k : targets) ids_to_erase.push_back(pipes[k].get_id());

        auto new_end = remove_if(pipes.begin(), pipes.end(),
            [&ids_to_erase](const MN& p) {
                return find(ids_to_erase.begin(), ids_to_erase.end(), p.get_id())
                    != ids_to_erase.end();
            });
        size_t erased = distance(new_end, pipes.end());
        pipes.erase(new_end, pipes.end());

        cout << "Удалено МН: " << erased << "\n";
        return;
    }

    // action 1..4 — редактирование поля
    if (action == 1) {
        string new_name;
        cout << "Новое наименование: ";
        getline(cin, new_name);
        if (new_name.empty()) { cout << "Пустое значение — отмена.\n"; return; }
        for (size_t k : targets) pipes[k].set_name(new_name);
        cout << "Наименование изменено у " << targets.size() << " МН.\n";
    }
    else if (action == 2) {
        string s;
        cout << "Новый диаметр (мм): ";
        getline(cin, s);
        int new_d;
        try {
            size_t pos = 0;
            new_d = stoi(s, &pos);
            if (pos != s.size() || new_d <= 0) throw runtime_error("bad");
        }
        catch (...) { cout << "Некорректный диаметр — отмена.\n"; return; }
        for (size_t k : targets) pipes[k].set_d(new_d);
        cout << "Диаметр изменён у " << targets.size() << " МН.\n";
    }
    else if (action == 3) {
        string s;
        cout << "Новая длина (км): ";
        getline(cin, s);
        float new_l;
        try {
            size_t pos = 0;
            new_l = stof(s, &pos);
            if (pos != s.size() || new_l <= 0.0f) throw runtime_error("bad");
        }
        catch (...) { cout << "Некорректная длина — отмена.\n"; return; }
        for (size_t k : targets) pipes[k].set_l(new_l);
        cout << "Длина изменена у " << targets.size() << " МН.\n";
    }
    else if (action == 4) {
        string s;
        cout << "Новый режим (0 - ремонт/остановлен, 1 - в работе): ";
        getline(cin, s);
        int r;
        try {
            size_t pos = 0;
            r = stoi(s, &pos);
            if (pos != s.size() || (r != 0 && r != 1)) throw runtime_error("bad");
        }
        catch (...) { cout << "Некорректный режим — отмена.\n"; return; }
        for (size_t k : targets) pipes[k].set_rejim(r != 0);
        cout << "Режим изменён у " << targets.size() << " МН.\n";
    }
    else {
        cout << "Нет такого действия. Отмена.\n";
        return;
    }

    // ---------- Шаг 5. Показ результата ----------
    cout << "\nОбновлённые МН:\n";
    for (size_t k : targets) {
        const MN& p = pipes[k];
        cout << "  id=" << p.get_id() << " | " << p.get_name()
            << " (D=" << p.get_d() << ", L=" << p.get_l()
            << ", " << (p.get_rejim() ? "в работе" : "в ремонте") << ")\n";
    }
}



