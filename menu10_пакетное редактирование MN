// Сохранение в файл (с уникальными id)
void Menu_6(const vector<MN>& pipes, const vector<NPS>& nps) {
    ofstream f_out("pipes.txt");
    if (!f_out) {
        cout << "Не удалось открыть файл для записи.\n";
        return;
    }

    // ---------- МН ----------
    f_out << pipes.size() << '\n';
    for (const MN& p : pipes) {
        f_out << p.get_id() << '\n'   // <-- id первым
            << p.get_name() << '\n'
            << p.get_d() << '\n'
            << p.get_l() << '\n'
            << p.get_rejim() << '\n';
    }

    // ---------- НПС ----------
    f_out << nps.size() << '\n';
    for (const NPS& p : nps) {
        f_out << p.get_id() << '\n'  // <-- id первым
            << p.get_name_nps() << '\n'
            << p.get_n_mna() << '\n'
            << p.get_on_mna() << '\n'
            << p.get_vid_nps() << '\n';
    }

    cout << "Данные сохранены в файл pipes.txt\n";
}

// Загрузка из файла (с восстановлением id)
void Menu_7(vector<MN>& pipes, vector<NPS>& nps) {
    ifstream f_in("pipes.txt");
    if (!f_in) {
        cout << "Файл не найден.\n";
        return;
    }

    // ---------- МН ----------
    size_t n;
    if (!(f_in >> n)) {
        cout << "Ошибка чтения файла (количество МН).\n";
        return;
    }
    f_in.ignore(10000, '\n');

    pipes.clear();
    for (size_t i = 0; i < n; ++i) {
        int id, d, r;
        string name;
        float l;

        f_in >> id;
        f_in.ignore(10000, '\n');
        getline(f_in, name);
        f_in >> d >> l >> r;
        f_in.ignore(10000, '\n');

        if (f_in.fail()) {
            cout << "Ошибка чтения МН #" << (i + 1) << ". Загрузка прервана.\n";
            return;
        }

        MN obj(name, d, l, r != 0);
        obj.set_id(id);                 // восстановить id
        pipes.push_back(obj);

        if (id >= MN::get_next_id())    // счётчик догоняет максимум
            MN::set_next_id(id + 1);
    }

    // ---------- НПС ----------
    size_t n1;
    if (!(f_in >> n1)) {
        cout << "Ошибка чтения файла (количество НПС).\n";
        return;
    }
    f_in.ignore(10000, '\n');

    nps.clear();
    for (size_t i = 0; i < n1; ++i) {
        int id, k, on, v;
        string name_nps;

        f_in >> id;
        f_in.ignore(10000, '\n');
        getline(f_in, name_nps);
        f_in >> k >> on >> v;
        f_in.ignore(10000, '\n');

        if (f_in.fail()) {
            cout << "Ошибка чтения НПС #" << (i + 1) << ". Загрузка прервана.\n";
            return;
        }

        NPS obj(name_nps, k, on, v != 0);
        obj.set_id(id);                 // восстановить id
        nps.push_back(obj);

        if (id >= NPS::get_next_id())   // счётчик догоняет максимум
            NPS::set_next_id(id + 1);
    }

    cout << "Данные загружены из файла pipes.txt\n";
    cout << "  Загружено МН:  " << pipes.size() << '\n'
        << "  Загружено НПС: " << nps.size() << '\n';
}

vector<size_t> find_pipes(const vector<MN>& pipes,      // для пакетного редактирования
    const string& name_query,
    int d_target,
    int r_target)
{
    auto to_lower = [](string s) {
        for (char& c : s) c = (char)tolower((unsigned char)c);
        return s;
        };
    string name_lower = to_lower(name_query);

    vector<size_t> result;
    for (size_t i = 0; i < pipes.size(); ++i) {
        const MN& p = pipes[i];

        if (!name_query.empty()) {
            string pname = to_lower(p.get_name());
            if (pname.find(name_lower) == string::npos) continue;
        }
        if (d_target != -1 && p.get_d() != d_target) continue;
        if (r_target != -1 && (int)p.get_rejim() != r_target) continue;

        result.push_back(i);
    }
    return result;
}

void Menu_8(const vector<MN>& pipes) {
    cout << "\n===== Поиск МН =====\n";
    if (pipes.empty()) {
        cout << "Список МН пуст. Сначала добавьте хотя бы один объект (пункт 1).\n";
        return;
    }
    cout << "(Оставьте поле пустым и нажмите Enter, чтобы НЕ учитывать критерий)\n\n";
    cin.ignore(10000, '\n');

    string name_query;
    cout << "Наименование содержит (Enter - не учитывать): ";
    getline(cin, name_query);

    string d_query;
    cout << "Диаметр (мм), или пусто: ";
    getline(cin, d_query);
    int d_target = -1;
    if (!d_query.empty()) {
        try {
            size_t pos = 0;
            d_target = stoi(d_query, &pos);
            if (pos != d_query.size()) d_target = -1;
        }
        catch (...) { d_target = -1; }
    }

    string r_query;
    cout << "Признак в ремонте (0 - нет, 1 - да, пусто - не учитывать): ";
    getline(cin, r_query);
    int r_target = -1;
    if (!r_query.empty()) {
        try {
            r_target = stoi(r_query);
            if (r_target != 0 && r_target != 1) r_target = -1;
        }
        catch (...) { r_target = -1; }
    }

    vector<size_t> idx = find_pipes(pipes, name_query, d_target, r_target);

    cout << "\n--- Результаты поиска ---\n";
    if (idx.empty()) {
        cout << "Ничего не найдено по заданным критериям.\n";
        return;
    }
    for (size_t i : idx) {
        const MN& p = pipes[i];
        cout << "МН [id=" << p.get_id() << "]\n"
            << "  Наименование: " << p.get_name() << '\n'
            << "  Диаметр:      " << p.get_d() << " мм\n"
            << "  Длина:        " << p.get_l() << " км\n"
            << "  Режим:        "
            << (p.get_rejim() ? "в работе" : "в ремонте/остановлен") << '\n'
            << "----------------------------------\n";
    }
    cout << "Найдено МН: " << idx.size() << "\n";
}

