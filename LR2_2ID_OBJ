// Редактировать МН (поиск по уникальному id)
void Menu_4(vector<MN>& pipes) {
    cout << "\n===== Редактирование МН =====\n";

    if (pipes.empty()) {
        cout << "Список МН пуст. Сначала добавьте хотя бы один объект (пункт 1).\n";
        return;
    }

    // 1. Вывод списка МН с их id
    cout << "Доступные МН:\n";
    for (const MN& p : pipes) {
        cout << "  id=" << p.get_id()
            << " | " << p.get_name()
            << " (D=" << p.get_d() << " мм, L=" << p.get_l() << " км, "
            << "Режим: " << (p.get_rejim() ? "в работе" : "остановлен") << ")\n";
    }
    // 2. Ввод id и поиск объекта
    int id;
    cout << "\nВведите id МН для редактирования: ";
    cin >> id;

    if (cin.fail()) {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Некорректный ввод. Возврат в меню.\n";
        return;
    }
    cin.ignore(10000, '\n');   // убираем '\n' после cin >> id

    auto it = find_if(pipes.begin(), pipes.end(),
        [id](const MN& p) { return p.get_id() == id; });

    if (it == pipes.end()) {
        cout << "Объект с id=" << id << " не найден. Возврат в меню.\n";
        return;
    }

    MN& selected_pipe = *it;   // ссылка на найденный объект

    // 3. Ввод новых данных
    string tmp_name;
    int d, r;
    float l;

    cout << "\nРедактирование МН [id=" << selected_pipe.get_id()
        << "]: " << selected_pipe.get_name() << "\n";
    cout << "(Оставьте поле пустым и нажмите Enter, чтобы сохранить текущее значение)\n\n";

    // Редактирование наименования
    cout << "Текущее наименование: " << selected_pipe.get_name() << "\n";
    cout << "Введите новое наименование: ";
    getline(cin, tmp_name);
    if (!tmp_name.empty()) {
        selected_pipe.set_name(tmp_name);
    }

    // Редактирование диаметра
    cout << "Текущий диаметр: " << selected_pipe.get_d() << " мм\n";
    cout << "Введите новый диаметр: ";
    string d_str;
    getline(cin, d_str);
    if (!d_str.empty()) {
        try {
            d = stoi(d_str);
            selected_pipe.set_d(d);
        }
        catch (...) {
            cout << "Ошибка ввода числа. Диаметр не изменен.\n";
        }
    }

    // Редактирование длины
    cout << "Текущая длина: " << selected_pipe.get_l() << " км\n";
    cout << "Введите новую длину: ";
    string l_str;
    getline(cin, l_str);
    if (!l_str.empty()) {
        try {
            l = stof(l_str);
            selected_pipe.set_l(l);
        }
        catch (...) {
            cout << "Ошибка ввода числа. Длина не изменена.\n";
        }
    }

    // Редактирование режима
    cout << "Текущий режим: "
        << (selected_pipe.get_rejim() ? "в работе" : "остановлен") << "\n";
    cout << "Введите новый режим (0 - остановлен, 1 - в работе): ";
    string r_str;
    getline(cin, r_str);
    if (!r_str.empty()) {
        try {
            r = stoi(r_str);
            selected_pipe.set_rejim(r != 0);
        }
        catch (...) {
            cout << "Ошибка ввода числа. Режим не изменен.\n";
        }
    }
    // 4. Вывод результата
    cout << "\nМН успешно отредактирован!\n";
    cout << "  id:           " << selected_pipe.get_id() << '\n'
        << "  Наименование: " << selected_pipe.get_name() << '\n'
        << "  Диаметр:      " << selected_pipe.get_d() << " мм\n"
        << "  Длина:        " << selected_pipe.get_l() << " км\n"
        << "  Режим:        "
        << (selected_pipe.get_rejim() ? "в работе" : "остановлен") << '\n';
}

