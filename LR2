// Редактировать МН
void Menu_4(vector<MN>& pipes) {
    cout << "\n===== Редактирование МН =====\n";

    if (pipes.empty()) {
        cout << "Список МН пуст. Сначала добавьте хотя бы один объект (пункт 1).\n";
        return;
    }


    cout << "Доступные МН:\n";
    for (size_t i = 0; i < pipes.size(); ++i) {
        cout << i + 1 << ". " << pipes[i].get_name()
            << " (D=" << pipes[i].get_d() << "мм, L=" << pipes[i].get_l() << "км), Режим - " << pipes[i].get_rejim() << "\n";
    }


    int index;
    cout << "\nВведите номер МН для редактирования (1-" << pipes.size() << "): ";
    cin >> index;

    if (cin.fail() || index < 1 || index >(int)pipes.size()) {
        cin.clear();
        cin.ignore(10000, '\n');
        cout << "Некорректный номер. Возврат в меню.\n";
        return;
    }

    MN& selected_pipe = pipes[index - 1];

    string tmp_name;
    int d, r;
    float l;

    cout << "\nРедактирование МН: " << selected_pipe.get_name() << "\n";
    cout << "(Оставьте поле пустым и нажмите Enter, чтобы сохранить текущее значение)\n\n";

    cout << "Текущее наименование: " << selected_pipe.get_name() << "\n";
    cout << "Введите новое наименование: ";
    getline(cin >> ws, tmp_name);
    if (!tmp_name.empty()) {
        selected_pipe.set_name(tmp_name);
    }

    // Редактирование диаметра
    cout << "Текущий диаметр: " << selected_pipe.get_d() << " мм\n";
    cout << "Введите новый диаметр: ";
    string d_str;
    getline(cin, d_str);
    if (!d_str.empty()) {
        try {
            d = stoi(d_str);
            selected_pipe.set_d(d);
        }
        catch (...) {
            cout << "Ошибка ввода числа. Диаметр не изменен.\n";
        }
    }

    // Редактирование длины
    cout << "Текущая длина: " << selected_pipe.get_l() << " км\n";
    cout << "Введите новую длину: ";
    string l_str;
    getline(cin, l_str);
    if (!l_str.empty()) {
        try {
            l = stof(l_str);
            selected_pipe.set_l(l);
        }
        catch (...) {
            cout << "Ошибка ввода числа. Длина не изменена.\n";
        }
    }

    // Редактирование режима
    cout << "Текущий режим: " << (selected_pipe.get_rejim() ? "в работе" : "остановлен") << "\n";
    cout << "Введите новый режим (0 - остановлен, 1 - в работе): ";
    string r_str;
    getline(cin, r_str);
    if (!r_str.empty()) {
        try {
            r = stoi(r_str);
            selected_pipe.set_rejim(r != 0);
        }
        catch (...) {
            cout << "Ошибка ввода числа. Режим не изменен.\n";
        }
    }

    cout << "\nМН успешно отредактирован!\n";
    cout << "  Наименование: " << selected_pipe.get_name() << '\n'
        << "  Диаметр:      " << selected_pipe.get_d() << " мм\n"
        << "  Длина:        " << selected_pipe.get_l() << " км\n"
        << "  Режим:        " << (selected_pipe.get_rejim() ? "в работе" : "остановлен") << '\n';
}

