void Menu_6(const vector<MN>& pipes, const vector<NPS>& nps) {
    ofstream f_out("pipes.txt");
    if (!f_out) {
        cout << "Не удалось открыть файл для записи.\n";
        return;
    }

    f_out << pipes.size() << '\n';
    for (const MN& p : pipes) {
        f_out << p.get_name() << '\n'
            << p.get_d() << '\n'
            << p.get_l() << '\n'
            << p.get_rejim() << '\n';
    }
    f_out << nps.size() << '\n';
    for (const NPS& p : nps) {
        f_out << p.get_name_nps() << '\n'
            << p.get_n_mna() << '\n'
            << p.get_on_mna() << '\n'
            << p.get_vid_nps() << '\n';
    }
    cout << "Данные сохранены в файл pipes.txt " << "\n";
}

void Menu_7(vector<MN>& pipes, vector<NPS>& nps) {
    ifstream f_in("pipes.txt");
    if (!f_in) {
        cout << "Файл не найден.\n";
        return;
    }

    size_t n;
    f_in >> n;
    f_in.ignore(10000, '\n');

    pipes.clear();
    for (size_t i = 0; i < n; ++i) {
        string name;
        int d, r;
        float l;

        getline(f_in, name);
        f_in >> d >> l >> r;
        f_in.ignore(10000, '\n');

        pipes.emplace_back(name, d, l, r != 0);
    }

    size_t n1;
    f_in >> n1;
    f_in.ignore(10000, '\n');

    nps.clear();
    for (size_t i = 0; i < n1; ++i) {
        string name_nps;
        int k, on, v;


        getline(f_in, name_nps);
        f_in >> k >> on >> v;
        f_in.ignore(10000, '\n');

        nps.emplace_back(name_nps, k, on, v != 0);
    }

    cout << "Данные загружены из файла pipes.txt" << "\n";
}

