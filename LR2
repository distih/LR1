class MN {
private:
    string name_mn;
    int d_mn;
    float l_mn;
    bool rejim_mn;

public:
    MN(const string& n = "", int d = 0, float l = 0.0f, bool r = false)
        : name_mn(n), d_mn(d), l_mn(l), rejim_mn(r) {
    }

    void set_name(const string& n) { name_mn = n; }
    void set_d(int d) { d_mn = d; }
    void set_l(float l) { l_mn = l; }
    void set_rejim(bool r) { rejim_mn = r; }

    string get_name()  const { return name_mn; }
    int    get_d()     const { return d_mn; }
    float  get_l()     const { return l_mn; }
    bool   get_rejim() const { return rejim_mn; }
};

class NPS {
private:
    string name_nps;
    int n_mna;
    int on_mna;
    bool vid_nps;

public:
    NPS(const string& nnps = "", int k = 0, int on = 0, bool v = false)
        : name_nps(nnps), n_mna(k), on_mna(on), vid_nps(v) {
    }

    void set_name_nps(const string& nnps) { name_nps = nnps; }
    void set_n_mna(int k) { n_mna = k; }
    void set_on_mna(int on) { on_mna = on; }
    void set_vid_nps(bool v) { vid_nps = v; }

    string get_name_nps()  const { return name_nps; }
    int    get_n_mna()     const { return n_mna; }
    float  get_on_mna()     const { return on_mna; }
    bool   get_vid_nps() const { return vid_nps; }
};


